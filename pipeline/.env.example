# Скопируйте этот файл в .env и перед запуском выполните:
#   set -a
#   source .env
#   set +a

# YTsaurus.
YT_PROXY=https://http-proxy-hackathon.demo.ytsaurus.tech/
YT_TOKEN=
YT_USER=
YT_POOL=default
YT_BASE_PATH=//home/hackathon/team25

# Служебные пути SPYT.
YT_POSITIONS_RAW_CONSUMER_PATH=${YT_BASE_PATH}/raw/positions_raw_consumer
YT_CHECKPOINT_PATH=${YT_BASE_PATH}/spark/checkpoints
YT_CODE_PATH=${YT_BASE_PATH}/spark/code
YT_DISCOVERY_PATH=${YT_BASE_PATH}/spark/discovery

# Пути таблиц. Обычно достаточно изменить только YT_BASE_PATH.
YT_POSITIONS_RAW_PATH=${YT_BASE_PATH}/raw/positions_raw
YT_REF_AIRCRAFT_PATH=${YT_BASE_PATH}/reference/ref_aircraft
YT_REF_AIRPORTS_PATH=${YT_BASE_PATH}/reference/ref_airports
YT_POSITIONS_CURRENT_PATH=${YT_BASE_PATH}/positions/positions_current
YT_POSITIONS_HISTORY_PATH=${YT_BASE_PATH}/positions/positions_history
YT_FLIGHTS_OPEN_PATH=${YT_BASE_PATH}/flights/flights_open
YT_FLIGHTS_SEGMENTS_PATH=${YT_BASE_PATH}/flights/flights_segments
YT_AIRPORT_EVENTS_PATH=${YT_BASE_PATH}/flights/airport_events
YT_DASHBOARD_TOTALS_PATH=${YT_BASE_PATH}/dashboard/dashboard_totals
YT_DASHBOARD_TREND_PATH=${YT_BASE_PATH}/dashboard/dashboard_trend
YT_DASHBOARD_TOP_AIRPORTS_PATH=${YT_BASE_PATH}/dashboard/dashboard_top_airports
YT_DASHBOARD_ROUTES_PATH=${YT_BASE_PATH}/dashboard/dashboard_routes
YT_DASHBOARD_MANUFACTURERS_PATH=${YT_BASE_PATH}/dashboard/dashboard_manufacturers
YT_PIPELINE_JOB_STATE_PATH=${YT_BASE_PATH}/system/pipeline_job_state

# История позиций хранится 10 часов: этого хватает на одну сессию OpenSky и анализ,
# но полный трек старше этого окна больше не гарантируется.
POSITIONS_HISTORY_RETENTION_SECONDS=36000
# Эти таблицы питают суточные dashboard-витрины, поэтому каждый TTL обязан быть
# строго больше DASHBOARD_WINDOW_SECONDS. Два дня дают запас на compaction и анализ.
FLIGHTS_SEGMENTS_RETENTION_SECONDS=172800
AIRPORT_EVENTS_RETENTION_SECONDS=172800
DASHBOARD_TREND_RETENTION_SECONDS=172800
# Уже обработанные строки queue сохраняются ещё 6 часов для диагностики.
QUEUE_RETAINED_LIFETIME_SECONDS=21600

# OpenSky. Bbox 10 x 20 градусов стоит 3 credits за запрос.
# Шаг 70 секунд расходует около 3703 из 4000 credits за 24 часа.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
OPENSKY_POLL_INTERVAL_SECONDS=70
# bbox — только заданная область; all — вся доступная карта без bbox-параметров.
OPENSKY_SCOPE=bbox
# Ingest сохраняет неизвестные категории null/0/1 и самолёты 2–7, но отбрасывает
# явно не-самолётные категории OpenSky 8–20.
OPENSKY_BBOX_LAMIN=45.0
OPENSKY_BBOX_LOMIN=5.0
OPENSKY_BBOX_LAMAX=55.0
OPENSKY_BBOX_LOMAX=25.0

# Входные данные для scripts/recommend_resources.py. Заполните ресурсами,
# которые можно выделить всему pipeline, а не ресурсами одного worker.
CLUSTER_AVAILABLE_CORES=
CLUSTER_AVAILABLE_MEMORY_GB=
EXPECTED_SNAPSHOT_ROWS=12000

# Ресурсы streaming job. Trigger сопоставим с периодом появления новых snapshots.
STREAMING_DRIVER_MEMORY=3g
STREAMING_DRIVER_MEMORY_OVERHEAD=2g
STREAMING_EXECUTOR_MEMORY=4g
STREAMING_EXECUTOR_CORES=2
STREAMING_NUM_EXECUTORS=4
STREAMING_SHUFFLE_PARTITIONS=32
STREAMING_TRIGGER_SECONDS=15
STREAMING_MAX_ROWS_PER_PARTITION=50000

# Segment job: запуск раз в 15 минут. Интервалы увеличены под snapshots раз в 70 секунд.
SEGMENT_INTERVAL_SECONDS=900
SEGMENT_DRIVER_MEMORY=4g
SEGMENT_DRIVER_MEMORY_OVERHEAD=2g
SEGMENT_EXECUTOR_MEMORY=4g
SEGMENT_EXECUTOR_CORES=2
SEGMENT_NUM_EXECUTORS=2
SEGMENT_SHUFFLE_PARTITIONS=16
AIRPORT_RADIUS_KM=15
FLIGHT_TIMEOUT_SECONDS=3600
MAX_TRANSITION_GAP_SECONDS=600
GROUND_GLITCH_MAX_SECONDS=180
ALLOWED_LATENESS_SECONDS=300
BBOX_EXIT_MARGIN_KM=25

# Aggregate job: пересчёт раз в 10 минут, окно показателей — последние сутки.
DASHBOARD_WINDOW_SECONDS=86400
POSITION_FRESHNESS_SECONDS=900
AGGREGATE_INTERVAL_SECONDS=600

# Используются только для локального тестового HTTP-сервера или моков.
# OPENSKY_TOKEN_URL=https://auth.opensky-network.org/auth/realms/opensky-network/protocol/openid-connect/token
# OPENSKY_STATES_URL=https://opensky-network.org/api/states/all

# Параметры отдельного SPYT-кластера; текущие direct-submit launcher'ы их не меняют.
WORKER_CORES=8
WORKER_NUM=3
WORKER_MEMORY=32G
