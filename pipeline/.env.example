YT_PROXY=https://http-proxy-hackathon.demo.ytsaurus.tech/
YT_TOKEN=
YT_BASE_PATH=//home/hackathon/<your-team>

OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
OPENSKY_POLL_INTERVAL_SECONDS=15
OPENSKY_DAILY_CREDIT_BUDGET=4000

# По умолчанию опрашивается весь мир — это 4 кредита за запрос. Четыре переменные
# ниже задают более узкое окно и удешевляют запрос: <=25 кв. градусов — 1 кредит,
# <=100 — 2, <=400 — 3. Задавать нужно все четыре сразу, иначе bbox игнорируется.
#
# Бюджет кредитов — это стоп-кран, а не регулятор частоты: на интервале 15 с выходит
# 5760 запросов в сутки, поэтому при глобальном опросе лимита в 4000 кредитов хватает
# примерно на 4 часа, дальше пауза до полуночи UTC. Это осознанный размен «плотный
# поток несколько часов» вместо «редкий поток круглосуточно».
# OPENSKY_BBOX_LAMIN=45.0
# OPENSKY_BBOX_LOMIN=5.0
# OPENSKY_BBOX_LAMAX=55.0
# OPENSKY_BBOX_LOMAX=25.0

# Обычно менять не нужно — для тестового стенда OpenSky или моков в тестах.
# OPENSKY_TOKEN_URL=https://auth.opensky-network.org/auth/realms/opensky-network/protocol/openid-connect/token
# OPENSKY_STATES_URL=https://opensky-network.org/api/states/all
