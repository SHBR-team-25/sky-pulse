# Скопируй в .env и подставь свои значения. .env в git не коммитится.

PORT=8080

# YTsaurus. Пути должны указывать на тот же YT_BASE_PATH, что использует пайплайн
# (см. pipeline/.env.example) — подставь вместо <your-team> своё имя команды.
YT_PROXY=localhost:80
YT_TOKEN=
YT_POSITIONS_CURRENT_PATH=//home/hackathon/<your-team>/positions/positions_current
YT_POSITIONS_HISTORY_PATH=//home/hackathon/<your-team>/positions/positions_history
YT_PIPELINE_JOB_STATE_PATH=//home/hackathon/<your-team>/system/pipeline_job_state
YT_REF_AIRPORTS_PATH=//home/hackathon/<your-team>/reference/ref_airports

# Через сколько секунд без продвижения watermark отдавать stale=true в /api/pipeline-status
PIPELINE_STALE_AFTER_SECONDS=120

# Борт, о котором не было позиции дольше этого времени, на карте не показываем
YT_MAX_POSITION_AGE_SECONDS=300

# Как долго держать в памяти снапшот справочника аэропортов (сутки по умолчанию)
YT_REF_AIRPORTS_CACHE_TTL_SECONDS=86400

# Таймауты запросов в YTsaurus, секунды
YT_CONNECT_TIMEOUT_SECONDS=3
YT_READ_TIMEOUT_SECONDS=20
