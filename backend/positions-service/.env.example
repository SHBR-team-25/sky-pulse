# Скопируй в .env и подставь свои значения. .env в git не коммитится.

PORT=8080

# YTsaurus. Пути должны указывать на тот же YT_BASE_PATH, что использует пайплайн.
YT_PROXY=localhost:80
YT_TOKEN=
YT_POSITIONS_CURRENT_PATH=//home/skypulse/positions_current
YT_POSITIONS_HISTORY_PATH=//home/skypulse/positions_history
YT_INGEST_HEARTBEAT_PATH=//home/skypulse/ingest_heartbeat

# Через сколько секунд без успешного опроса отдавать stale=true в /api/pipeline-status
PIPELINE_STALE_AFTER_SECONDS=120

# Борта старше этого возраста не показываем, и не больше N бортов в одном ответе
YT_MAX_POSITION_AGE_SECONDS=300
YT_MAX_CURRENT_POSITIONS=5000
