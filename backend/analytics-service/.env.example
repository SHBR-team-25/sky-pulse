# Скопируй в .env и подставь свои значения. .env в git не коммитится.

PORT=8081

# YTsaurus. Пути должны указывать на тот же YT_BASE_PATH, что использует пайплайн
# (см. pipeline/.env.example) — подставь вместо <your-team> своё имя команды.
YT_PROXY=localhost:80
YT_TOKEN=
YT_REF_AIRPORTS_PATH=//home/hackathon/<your-team>/ref_airports
YT_POSITIONS_CURRENT_PATH=//home/hackathon/<your-team>/positions_current
YT_DASHBOARD_TOTALS_PATH=//home/hackathon/<your-team>/dashboard_totals
YT_DASHBOARD_TREND_PATH=//home/hackathon/<your-team>/dashboard_trend
YT_DASHBOARD_TOP_AIRPORTS_PATH=//home/hackathon/<your-team>/dashboard_top_airports
YT_DASHBOARD_ROUTES_PATH=//home/hackathon/<your-team>/dashboard_routes
YT_DASHBOARD_MANUFACTURERS_PATH=//home/hackathon/<your-team>/dashboard_manufacturers

# Как долго держать в памяти снапшот справочника аэропортов (сутки по умолчанию)
YT_REF_AIRPORTS_CACHE_TTL_SECONDS=86400

# Сколько строк отдавать в топах и сколько точек — в тренде
STATS_TOP_LIMIT=10
STATS_TREND_LIMIT=100

# Таймауты запросов в YTsaurus, секунды
YT_CONNECT_TIMEOUT_SECONDS=3
YT_READ_TIMEOUT_SECONDS=20
