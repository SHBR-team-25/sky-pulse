{
    "name": "frontend",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "preview": "vite preview",
        "format": "prettier --write \"**/*.{ts,tsx}\"",
        "typecheck": "tsc -b",
        "prepare": "cd .. && husky frontend/.husky",
        "generateApi": "openapi-typescript ../docs/openapi.yaml -o ./src/shared/api/generated-types.ts",
        "generateApi:check": "openapi-typescript ../docs/openapi.yaml -o ./src/shared/api/generated-types.ts --check",
        "docs:tree": "node scripts/generate-tree.mjs",
        "docs:tree:check": "node scripts/generate-tree.mjs --check"
    },
    "dependencies": {
        "@gravity-ui/charts": "^1.57.2",
        "@gravity-ui/date-components": "^4.0.0",
        "@gravity-ui/date-utils": "^2.7.1",
        "@gravity-ui/icons": "^2.21.0",
        "@gravity-ui/uikit": "^7.47.2",
        "@tanstack/react-query": "^5.101.4",
        "@yandex/ymaps3-clusterer": "^0.0.12",
        "@yandex/ymaps3-default-ui-theme": "^0.0.25",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-error-boundary": "^6.1.2",
        "react-router": "^8.3.0"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.1",
        "@commitlint/config-conventional": "^21.2.0",
        "@emnapi/core": "^1.11.3",
        "@emnapi/runtime": "^1.11.3",
        "@emnapi/wasi-threads": "^2.0.1",
        "@eslint/js": "^10.0.1",
        "@types/node": "^24.13.3",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.4",
        "@yandex/ymaps3-types": "^1.0.20315584",
        "eslint": "^10.8.0",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-boundaries": "^7.1.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.3",
        "globals": "^17.7.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.3.0",
        "openapi-typescript": "^7.13.0",
        "prettier": "^3.9.6",
        "typescript": "~5.9.3",
        "typescript-eslint": "^8.65.0",
        "vite": "^8.2.0",
        "vite-tsconfig-paths": "^6.1.1"
    },
    "lint-staged": {
        "*.{ts,tsx}": [
            "eslint --fix",
            "prettier --write"
        ]
    }
}
